# Overrides matching keys in .env, but only for `next build` (the static export used by
# the GitHub Pages deploy) — never for `next dev`, so local development keeps talking to
# your local API on 127.0.0.1:8000 unaffected. See .env for the shared/base config.

NEXT_PUBLIC_API_BASE_URL=https://nature-commons-api-951150419753.australia-southeast1.run.app
